# All optional for local development.

# Postgres (Neon, Supabase, RDS…). Unset → embedded PGlite in .data/pglite.
DATABASE_URL=

# Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL in production, e.g. https://book.example.com
BETTER_AUTH_URL=
# Base URL for links in emails, embed snippets and QR codes.
NEXT_PUBLIC_APP_URL=

# AI brand matching (xAI Grok). Without it, theme detection uses heuristics.
XAI_API_KEY=
# Optional model override (default grok-4.20-0309-non-reasoning; grok-4.7 is slower, more capable).
XAI_MODEL=

# Email via Resend. Without it, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Bookings <bookings@yourdomain.com>"
