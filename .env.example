# All optional for local development.

# Postgres (Neon, Supabase, RDS…). Unset → embedded PGlite in .data/pglite.
DATABASE_URL=

# Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL in production, e.g. https://book.example.com
BETTER_AUTH_URL=
# Base URL for links in emails, embed snippets and QR codes.
NEXT_PUBLIC_APP_URL=

# AI brand matching (xAI Grok). Without it, theme detection uses heuristics.
XAI_API_KEY=
# Optional model override (default grok-4.20-0309-non-reasoning; grok-4.7 is slower, more capable).
XAI_MODEL=

# Email via Resend. Without it, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Bookings <bookings@yourdomain.com>"

# --- Production operations -------------------------------------------------

# Postgres pool per server instance (default 3 on Vercel, 10 elsewhere). Point
# DATABASE_URL at a pooler (e.g. Neon's "-pooler" host) in serverless deploys.
DATABASE_POOL_MAX=
# Protects /api/cron/*; Vercel Cron sends it as "Authorization: Bearer …". openssl rand -hex 32
CRON_SECRET=
# Single-value header your edge sets to the real client IP (e.g. cf-connecting-ip).
# Unset: x-real-ip on Vercel, otherwise the right-most x-forwarded-for entry.
TRUSTED_IP_HEADER=
# Online bookings one clinic accepts per hour before we assume abuse (default 40).
BOOKINGS_PER_BUSINESS_HOURLY=
# AI theme detections per day across the platform (default 300); past it, heuristics only.
THEME_AI_DAILY_LIMIT=

# Cloudflare Turnstile bot check on the booking form. Both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where clinics reach you (Viber/Messenger/mailto link); adds "Help & support" to the dashboard menu.
NEXT_PUBLIC_SUPPORT_URL=
# Shown in the Privacy Policy and Terms.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=
# Slack/Discord-style webhook that receives server error alerts.
ERROR_WEBHOOK_URL=
